{
  "manifest_version": 3,
  "name": "GitHub CODEOWNERS Filter",
  "version": "1.0.0",
  "description": "Filter files in GitHub pull request diffs by any code owner (users or teams) from CODEOWNERS.",
  "homepage_url": "https://github.com/gautam-bansal-toddle/github-codeowners-filter",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["codeowners.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
